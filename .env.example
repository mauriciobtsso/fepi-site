# ============================================================================
# CONFIGURAÇÃO DE E-MAIL - BREVO (Anteriormente Sendinblue)
# ============================================================================
# Credenciais SMTP Brevo (para fallback)
EMAIL_HOST_USER=seu-email-no-brevo@exemplo.com
EMAIL_HOST_PASSWORD=sua-senha-smtp-brevo

# Chave API HTTP Brevo (OBRIGATÓRIA para envio via API HTTP - Porta 443)
# Esta é a chave "Chave de API Chave HTTP" (xkeysib-...)
BREVO_API_KEY=sua-chave-api-http-brevo-aqui

# ============================================================================
# OUTRAS CONFIGURAÇÕES
# ============================================================================
SECRET_KEY=sua-chave-secreta-django
DEBUG=False
ALLOWED_HOSTS=fepiaui.org.br,www.fepiaui.org.br
DATABASE_URL=postgresql://user:password@host:5432/dbname
